#!/bin/bash
# upgrade_docker — met à jour les conteneurs QUI TOURNENT (stacks Compose + standalone)
#
#   --dry-run          liste les mises à jour disponibles, ne touche à rien
#   --image IMAGE      ne traite que les stacks/conteneurs qui utilisent cette image
#   --exclude NOM      ignore une stack, un conteneur ou une image (répétable)
#   --compose-only     stacks Compose uniquement
#   --standalone-only  conteneurs standalone uniquement
#   --no-build         ne reconstruit pas les services 'build:' (même si leur base a bougé)
#   --force-reboot     recrée les stacks même sans nouvelle image
#   --no-prune         garde les images obsolètes
#   --timeout N        timeout d'un pull, en secondes, par stack ou image   [600]
#   --log FILE         fichier de log                     [/var/log/docker-update.log]
#   --notify EMAIL     mail en cas d'échec (nécessite 'mail')
#   --help             cette aide
#
# À lancer en root : les stacks Portainer vivent dans un volume non lisible sinon.
set -uo pipefail

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit "${1:-0}"; }

DRY_RUN=false PRUNE=true BUILD=true FORCE_REBOOT=false COMPOSE=true STANDALONE=true
IMAGE="" TIMEOUT=600 NOTIFY_EMAIL="" LOG_FILE=/var/log/docker-update.log EXCLUDE=() FAILED=()
while (($#)); do
    case $1 in
        --dry-run)         DRY_RUN=true ;;
        --no-prune)        PRUNE=false ;;
        --no-build)        BUILD=false ;;
        --force-reboot)    FORCE_REBOOT=true ;;
        --compose-only)    STANDALONE=false ;;
        --standalone-only) COMPOSE=false ;;
        --image)           IMAGE="${2:?--image attend une image}"; shift ;;
        --exclude)         EXCLUDE+=("${2:?--exclude attend un nom}"); shift ;;
        --timeout)         TIMEOUT="${2:?--timeout attend un nombre}"; shift ;;
        --log)             LOG_FILE="${2:?--log attend un chemin}"; shift ;;
        --notify)          NOTIFY_EMAIL="${2:?--notify attend un email}"; shift ;;
        --help|-h)         usage ;;
        *) echo "Option inconnue : $1" >&2; usage 1 ;;
    esac
    shift
done
$COMPOSE || $STANDALONE || { echo "--compose-only et --standalone-only sont exclusifs" >&2; exit 1; }

touch "$LOG_FILE" 2>/dev/null && exec > >(tee -a "$LOG_FILE") 2>&1
log() { echo "[$(date '+%F %T')] $*"; }

# Vrai si l'un des noms (stack, conteneur, image) est exclu
excluded() { local n e; for n; do for e in "${EXCLUDE[@]}"; do [[ $n == "$e" ]] && return 0; done; done; return 1; }
# Vrai si --image est absent, ou si l'une des images listées y correspond (tag :latest implicite)
wanted() { [[ -z $IMAGE ]] && return 0; local i; for i; do [[ $i == "$IMAGE" || $i:latest == "$IMAGE" || $i == "$IMAGE:latest" ]] && return 0; done; return 1; }

# Stacks Portainer : leurs labels donnent /data/compose/N, chemin vu DEPUIS le conteneur Portainer
PORTAINER_DATA=$(docker volume inspect -f '{{.Mountpoint}}' portainer_data 2>/dev/null)
host_path() { [[ $1 == /data/* && ! -e $1 && -n $PORTAINER_DATA ]] && echo "$PORTAINER_DATA${1#/data}" || echo "$1"; }

# Vrai si le registry a un digest absent de l'image locale. Utilise les identifiants docker.
# Résultat mis en cache : Docker Hub répond 429 si on l'interroge trop (bases partagées).
declare -A SEEN=()
has_update() {
    [[ -v SEEN[$1] ]] && return "${SEEN[$1]}"
    local local_digests remote rc=1
    local_digests=$(docker image inspect -f '{{join .RepoDigests " "}}' "$1" 2>/dev/null)
    if [[ -z $local_digests ]]; then
        :   # image absente localement : rien à comparer
    elif ! remote=$(docker buildx imagetools inspect "$1" --format '{{.Manifest.Digest}}' 2>&1); then
        # Absente du registry (avec nos identifiants) = image buildée localement : silence
        [[ $remote == *"does not exist"* || $remote == *"not found"* ]] \
            || log "  [?] $1 : non vérifiable — ${remote##*: }"
    elif [[ $local_digests != *"$remote"* ]]; then
        rc=0
    fi
    SEEN[$1]=$rc
    return $rc
}

# Conteneurs qui tournent sur une image plus vieille que celle que porte leur tag
stale() {
    local c
    for c; do
        [[ $(docker inspect -f '{{.Image}}' "$c") != \
           $(docker image inspect -f '{{.Id}}' "$(docker inspect -f '{{.Config.Image}}' "$c")" 2>/dev/null) ]] \
            && { local n; n=$(docker inspect -f '{{.Name}}' "$c"); echo "${n#/}"; }
    done
}

# Services 'build:' : pull les images de base (FROM) qui ont une MAJ ; vrai s'il faut rebuild.
# Pas de rebuild sinon : on met à jour des images, on ne redéploie pas le code local.
bases_updated() {
    local df base need=1
    while read -r df; do
        while read -r base; do
            has_update "$base" || continue
            log "  [BASE] $base : mise à jour disponible"
            if $DRY_RUN || timeout "$TIMEOUT" docker pull -q "$base" >/dev/null; then need=0
            else FAILED+=("pull:$base"); fi
        done < <(awk 'tolower($1) == "from" {
                    i = ($2 ~ /^--/) ? 3 : 2; img = $i
                    if (tolower($(i+1)) == "as") st[tolower($(i+2))] = 1
                    if (!(tolower(img) in st) && img !~ /\$/ && img != "scratch") print img
                 }' "$df" 2>/dev/null | sort -u)
    done < <(docker compose "$@" config --format json 2>/dev/null | jq -r '.services[].build | select(.)
             | (.dockerfile // "Dockerfile") as $d | if ($d | startswith("/")) then $d else .context + "/" + $d end')
    return $need
}

log "=== Démarrage$($DRY_RUN && echo ' [DRY-RUN]') ==="

# --- Stacks Compose : découvertes via les labels des conteneurs qui tournent ---
$COMPOSE && while IFS='|' read -r -u3 proj files envs; do
    mapfile -t ids < <(docker ps -q --filter "label=com.docker.compose.project=$proj")
    mapfile -t imgs < <(docker inspect -f '{{.Config.Image}}' "${ids[@]}" | sort -u)
    wanted "${imgs[@]}" || continue
    excluded "$proj" && { log "[SKIP] $proj (exclue)"; continue; }

    args=(-p "$proj")
    IFS=, read -ra f <<<"$files"; for x in "${f[@]}"; do args+=(-f "$(host_path "$x")"); done
    IFS=, read -ra f <<<"$envs";  for x in "${f[@]}"; do args+=(--env-file "$(host_path "$x")"); done
    [[ -r ${args[3]} ]] || { log "[SKIP] $proj : ${args[3]} illisible (lancer en root ?)"; FAILED+=("compose:$proj"); continue; }

    log "[STACK] $proj"
    rebuild=false
    if ! $BUILD; then :
    elif bases_updated "${args[@]}" || $FORCE_REBOOT; then rebuild=true; fi

    if $DRY_RUN; then
        for c in $(stale "${ids[@]}"); do log "  [À RECRÉER] $c : tourne sur une ancienne image"; done
        for img in "${imgs[@]}"; do has_update "$img" && log "  [UPDATE] $img"; done
        continue
    fi

    timeout "$TIMEOUT" docker compose "${args[@]}" pull -q --ignore-buildable || { FAILED+=("pull:$proj"); continue; }
    if $rebuild && ! docker compose "${args[@]}" build -q; then FAILED+=("build:$proj"); continue; fi

    # 'up -d' seulement si un conteneur a changé d'image : sinon Compose recrée quand même
    # les services en network_mode: service:X (redémarrage pour rien à chaque passage)
    mapfile -t old < <(stale $(docker compose "${args[@]}" ps -q))
    if $FORCE_REBOOT; then
        log "  [FORCE-REBOOT] recréation de toute la stack"
        docker compose "${args[@]}" up -d --force-recreate || FAILED+=("up:$proj")
    elif ((${#old[@]})); then
        log "  [UPDATE] ${old[*]}"
        docker compose "${args[@]}" up -d || FAILED+=("up:$proj")
    fi
done 3< <(docker ps --format '{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.compose.project.config_files"}}|{{.Label "com.docker.compose.project.environment_file"}}' \
          | awk -F'|' '$1 != ""' | sort -u)

# --- Standalone : pull + signalement. Pas de recréation : un `docker run` reconstruit
# depuis l'inspect perd toujours un réglage. Mettez-les en Compose pour l'automatiser.
# ponytail: Portainer est le seul concerné ici ; recréation auto si ça se multiplie.
$STANDALONE && while read -r -u3 name proj; do
    [[ -n $proj || $name == buildx_buildkit_* ]] && continue
    img=$(docker inspect -f '{{.Config.Image}}' "$name")
    wanted "$img" || continue
    excluded "$name" "$img" && { log "[SKIP] $name (exclu)"; continue; }
    if $DRY_RUN; then
        has_update "$img" && log "[UPDATE] $name ($img)"
    else
        timeout "$TIMEOUT" docker pull -q "$img" >/dev/null || { FAILED+=("pull:$img"); continue; }
    fi
    [[ -n $(stale "$name") ]] && log "[À RECRÉER] $name : tourne sur une ancienne image de $img (recréation manuelle)"
done 3< <(docker ps --format '{{.Names}} {{.Label "com.docker.compose.project"}}')

$PRUNE && ! $DRY_RUN && docker image prune -f

((${#FAILED[@]})) || { log "=== OK ==="; exit 0; }
log "=== ÉCHECS : ${FAILED[*]} ==="
[[ -n $NOTIFY_EMAIL ]] && printf '%s\n' "${FAILED[@]}" | mail -s "[FAIL] upgrade_docker" "$NOTIFY_EMAIL"
exit 1
